# GitHub Personal Access Token (fine-grained, read-only: Contents, Metadata, Issues, Pull requests, Actions)
GITHUB_TOKEN=

# Secret used to verify GitHub webhook signatures (set the same value in GitHub webhook config)
GITHUB_WEBHOOK_SECRET=

# Your GitHub username (used for backfill/sync)
GITHUB_USERNAME=

# Password for dashboard login
DASHBOARD_PASSWORD=

# Secret for signing session cookies (use a long random string)
SESSION_SECRET=

# SQLite database file path (Local development)
DATABASE_URL="file:./data/dashboard.db"

# Cloud Database via Turso (Required when deployed on Vercel)
# TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# Public base URL (e.g. https://your-app.vercel.app or http://localhost:3000)
PUBLIC_BASE_URL=http://localhost:3000
